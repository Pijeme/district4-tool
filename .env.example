# Docker Hub repository and tag (no https:// prefix).
DOCKER_IMAGE=pijeme/district4-tool-main
IMAGE_TAG=latest
APP_PORT=5000
APP_BIND_ADDRESS=0.0.0.0
TZ=Asia/Manila

# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
GEMINI_API_KEY=

# Copy service_account.json beside compose.yml and .env on the server.
# Compose mounts it read-only and sets its container path automatically.

# Required if you use Thanksgiving Pledges.
PLEDGE_SCRIPT_URL=
PLEDGE_API_TOKEN=

# CCM uploads to a personal Drive folder: deploy deployment/ccm_drive.gs as its owner.
# These are separate from the CCM admin password and the pledge connection.
CCM_DRIVE_SCRIPT_URL=
CCM_DRIVE_API_TOKEN=

# Event uploads use their own project, private token, and folder.
# Deploy deployment/event_drive.gs and run setupEventDrive as the folder owner.
EVENT_DRIVE_SCRIPT_URL=
EVENT_DRIVE_API_TOKEN=

# Personal Sermon Notes backup and two-way sync.
# Deploy deployment/sermon_notes_drive.gs under the destination folder owner.
SERMON_NOTES_DRIVE_SCRIPT_URL=
SERMON_NOTES_DRIVE_API_TOKEN=

# Separate private credential for the Android MASTER only; never give it to SLAVEs.
# Generate a random token of at least 32 characters. Leave blank to disable sync.
EVENT_MEAL_MASTER_TOKEN=
EVENT_MEAL_MASTER_ID=master

# Set private tokens if you use the temporary editing routes.
TEMP_EDIT_USER_TOKEN=
TEMP_EDIT_ADMIN_TOKEN=

# Keep a single Gunicorn worker: background jobs use process-local state.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180

# Optional persistent local ebook cover folder (path inside the app/container).
# Defaults to DATA_DIR/book_thumbnail_cache; Docker defaults to /data/book_thumbnail_cache.
# BOOK_THUMBNAIL_DIR=/data/book_thumbnail_cache

# Temporary ebook-library maintenance page. Set to 0 and restart to reopen the library.
EBOOK_LIBRARY_MAINTENANCE=1
