# Docker Hub repository and tag (no https:// prefix).
DOCKER_IMAGE=pijeme/district4-tool-main
IMAGE_TAG=latest
APP_PORT=5000
APP_BIND_ADDRESS=0.0.0.0
TZ=Asia/Manila

# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
GEMINI_API_KEY=

# Paste one line of base64-encoded service_account.json here.
# This removes the need to copy a separate credential file to the server.
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Alternative: GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Use single quotes around JSON; preserve private_key's literal \n escapes.

# Required if you use Thanksgiving Pledges.
PLEDGE_SCRIPT_URL=
PLEDGE_API_TOKEN=

# Set private tokens if you use the temporary editing routes.
TEMP_EDIT_USER_TOKEN=
TEMP_EDIT_ADMIN_TOKEN=

# Keep a single Gunicorn worker: background jobs use process-local state.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
